# Example environment-variable names ONLY. Never commit a real key.
# For PowerShell: $env:GOOGLE_TRANSLATE_API_KEY = "your-own-key"
GOOGLE_TRANSLATE_API_KEY=

# Optional training exercise: separate from the main RSS headlines.
NEWS_API_KEY=

# Set to 0 to disable article-page og:image lookup.
CYBERNEWS_FETCH_OG_IMAGES=1

# Localhost HTTP demo: 0. Use 1 only behind correctly configured HTTPS.
COOKIE_SECURE=0
